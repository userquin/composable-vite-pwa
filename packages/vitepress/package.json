{
  "name": "@composable-vite-pwa/vitepress",
  "type": "module",
  "version": "1.2.0",
  "description": "Zero-config PWA for VitePress",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/vitepress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/vitepress.git"
  },
  "bugs": "https://github.com/vite-pwa/vitepress/issues",
  "keywords": [
    "vitepress",
    "workbox",
    "pwa",
    "vite",
    "vite-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "dev": "./src/types.ts",
      "default": "./dist/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0",
    "vitepress": "^1.0.0 || ^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@composable-vite-pwa/unplugin-pwa": "workspace:*",
    "@composable-vite-pwa/workbox-build": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitepress": "catalog:vitepress2"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  }
}
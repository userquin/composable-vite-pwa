{
  "name": "@composable-vite-pwa/react-router",
  "type": "module",
  "version": "0.0.0",
  "description": "Zero-config PWA for React Router",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/react-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/react-router.git"
  },
  "bugs": "https://github.com/vite-pwa/react-router/issues",
  "keywords": [
    "react router",
    "react router preset",
    "workbox",
    "pwa",
    "vite",
    "vite-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./preset": "./dist/preset.mjs",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "preset": [
        "dist/preset.d.mts"
      ],
      "types": [
        "dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@react-router/dev": "^7.0.0 || ^8.0.0",
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@composable-vite-pwa/unplugin-pwa": "workspace:*",
    "@composable-vite-pwa/workbox-build": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:rr8",
    "react-router": "catalog:rr8",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}
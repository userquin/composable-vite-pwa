{
  "name": "@composable-vite-pwa/workbox-types",
  "type": "module",
  "version": "0.0.0",
  "description": "TypeDoc JSON metadata for the @composable-vite-pwa workbox packages, published for the Vite PWA docs site to render its API reference.",
  "author": "Google's Web DevRel Team, Vite PWA's Team",
  "contributors": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/userquin/composable-vite-pwa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/userquin/composable-vite-pwa.git",
    "directory": "packages/workbox/types"
  },
  "bugs": "https://github.com/userquin/composable-vite-pwa/issues",
  "keywords": [
    "workbox",
    "workboxjs",
    "service worker",
    "caching",

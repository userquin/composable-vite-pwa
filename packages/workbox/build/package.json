{
  "name": "@composable-vite-pwa/workbox-build",
  "type": "module",
  "version": "0.0.0",
  "description": "A module that integrates into your build process, helping you generate a manifest of local files that workbox-sw should precache.",
  "author": "Google's Web DevRel Team, Vite PWA's Team",
  "contributors": [
    "userquin <userquin@gmail.com>"
  ],
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/userquin/composable-vite-pwa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/userquin/composable-vite-pwa.git",
    "directory": "packages/workbox/build"
  },
  "bugs": "https://github.com/userquin/composable-vite-pwa/issues",
  "keywords": [
    "workbox",
    "workboxjs",
    "service worker",
    "caching",
    "fetch requests",
    "offline",
    "file manifest"
  ],
  "sideEffects": false,
  "exports": {
    "./generate-sw": "./dist/generate-sw.mjs",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "generate-sw": [
        "./dist/generate-sw.d.mts"
      ],
      "types": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "node:test": "node ./dist/generate-sw.mjs",
    "tsx:test": "tsx ./src/generate-sw.ts"
  },
  "dependencies": {
    "@composable-vite-pwa/workbox-swkit": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*",
    "magicast": "catalog:utils",
    "pathe": "catalog:utils",
    "pkg-types": "catalog:utils",
    "proper-tags": "catalog:utils",
    "serialize-javascript": "catalog:utils",
    "tinyglobby": "catalog:utils",
    "valibot": "catalog:utils"
  },
  "devDependencies": {
    "@types/serialize-javascript": "catalog:types"
  }
}

{
  "name": "@composable-vite-pwa/astro",
  "type": "module",
  "version": "1.2.0",
  "description": "Zero-config PWA for Astro",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/astro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/astro.git"
  },
  "bugs": "https://github.com/vite-pwa/astro/issues",
  "keywords": [
    "astro-integration",
    "astro",
    "workbox",
    "pwa",
    "vite",
    "vite-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "xbuild": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@composable-vite-pwa/unplugin-pwa": "workspace:*",
    "@composable-vite-pwa/workbox-build": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*"
  },
  "devDependencies": {
    "astro": "catalog:astro",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}
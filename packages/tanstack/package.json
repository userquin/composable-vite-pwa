{
  "name": "@composable-vite-pwa/tanstack",
  "type": "module",
  "version": "0.0.0",
  "description": "Zero-config PWA for TanStack",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/tanstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/tanstack.git"
  },
  "bugs": "https://github.com/vite-pwa/tanstack/issues",
  "keywords": [
    "tanstack",
    "tanstack start",
    "workbox",
    "pwa",
    "vite",
    "vite-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./types": {
      "types": "./dist/types.d.mts"
    },
    "./create-pwa-context": "./dist/create-pwa-context.mjs",
    "./plugins/build-sw": "./dist/plugins/build-sw.mjs",
    "./plugins/nitro": "./dist/plugins/nitro.mjs",
    "./react-components":  "./dist/react-components.mjs",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "create-pwa-context": [
        "dist/create-pwa-context.d.mts"
      ],
      "plugins/build-sw": [
        "dist/plugins/build-sw.d.mts"
      ],
      "plugins/nitro": [
        "dist/plugins/nitro.d.mts"
      ],
      "react-components": [
        "dist/react-components.d.mts"
      ],
      "types": [
        "dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "nitro": "^3.0.0-0",
    "rolldown": "^1.0.0-0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@composable-vite-pwa/unplugin-pwa": "workspace:*",
    "@composable-vite-pwa/workbox-build": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*"
  },
  "devDependencies": {
    "nitro": "catalog:nitrov3",
    "react": "catalog:tanstackreact",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}
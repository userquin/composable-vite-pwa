    "./node/vite/plugins/info": "./dist/node/vite/plugins/info.mjs",
    "./node/vite/plugins/main": "./dist/node/vite/plugins/main.mjs",
    "./node/vite/plugins/pwa-assets": "./dist/node/vite/plugins/pwa-assets.mjs",

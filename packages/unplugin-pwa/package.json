    "./vanillajs": {
      "types": "./vanillajs.d.ts"
    },
    "./vue": {
      "types": "./vue.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./info": {
      "types": "./info.d.ts"
    },
    "./pwa-assets": {
      "types": "./pwa-assets.d.ts"
    },
    "./package.json": "./package.json"

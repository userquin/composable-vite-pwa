    "./node/additional-manifest-entries": "./dist/node/additional-manifest-entries.mjs",
    "./node/assets": "./dist/node/assets.mjs",
    "./node/build-pwa-asset": "./dist/node/build-pwa-asset.mjs",
    "./node/config": "./dist/node/config.mjs",
    "./node/constants": "./dist/node/constants.mjs",

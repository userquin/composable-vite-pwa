{
  "name": "@composable-vite-pwa/sveltekit",
  "type": "module",
  "version": "1.1.0",
  "description": "Zero-config PWA for SvelteKit",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/sveltekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/sveltekit.git"
  },
  "bugs": "https://github.com/vite-pwa/sveltekit/issues",
  "keywords": [
    "sveltekit",
    "workbox",
    "pwa",
    "vite",
    "vite-plugin"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./legacy": "./dist/legacy.mjs",
    "./types": {
      "types": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "legacy": [
        "./dist/legacy.d.mts"
      ],
      "types": [
        "./dist/types.d.mts"
      ],
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test:typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^1.3.1 || ^2.0.1 || ^3.0.0-0",
    "@vite-pwa/assets-generator": "^1.0.0 || ^2.0.0",
    "magicast": "^0.5.0",
    "rolldown": "^1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@vite-pwa/assets-generator": {
      "optional": true
    },
    "magicast": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@composable-vite-pwa/unplugin-pwa": "workspace:*",
    "@composable-vite-pwa/workbox-build": "workspace:*",
    "@composable-vite-pwa/workbox-window": "workspace:*",
    "verkit": "catalog:utils"
  },
  "devDependencies": {
    "@sveltejs/kit": "catalog:sveltekit2",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}